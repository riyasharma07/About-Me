# --- Frontend (Vite, baked into the GitHub Pages build) ---
# URL of the deployed Iris function on Vercel
VITE_IRIS_API_URL=https://your-project.vercel.app/api/iris

# --- Backend (put in .env.local locally and in Vercel project settings; never in the frontend) ---
GOOGLE_API_KEY=                      # free key from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-flash-lite-latest  # optional
ALLOWED_ORIGINS=https://riyasharma07.github.io,http://localhost:5173
